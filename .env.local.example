# Supabase connection strings
# DATABASE_URL: Transaction URL (pooled) - usually port 6543
DATABASE_URL="postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Session URL (direct) - usually port 5432
DIRECT_URL="postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="ganti-dengan-string-random-panjang"
NEXTAUTH_URL="http://localhost:3000"
